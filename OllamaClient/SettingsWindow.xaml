<Window x:Class="OllamaClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OllamaClient"
        mc:Ignorable="d"
        Title="Настройки" Height="450" Width="500" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Ollama url:"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbOllamaUrl" Width="240" Margin="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Таймаут подключения (с):"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbOllamaTimeout" Width="240" Margin="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Модель по умолчанию:"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbDefaultModel" Width="240" Margin="5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Промпт по умолчанию:"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="tbDefaultPrompt" Width="240" Margin="5"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Температура:"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="tbTemperature" Width="240" Margin="5"/>

        <Button Grid.Row="5" Content="Сохранить" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="Button_Save_Click" Grid.Column="0" Margin="10"/>
        <Button Grid.Row="5" Content="Отмена" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="Button_Cancel_Click" Grid.Column="1" Margin="10"/>

    </Grid>
</Window>
